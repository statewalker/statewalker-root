@@ -880,6 +923,80 @@ export class Ports {
     this.#core = core;
   }
 
+  /**
+   * Send one HTTP request to a guest TCP listener and return its response,
+   * without a ServiceWorker or a host port. The embedder sees and can
+   * authorize every request it forwards.
+   *
+   * Needs browser ingress networking, as `serve()` does; fails with
+   * `CAPABILITY_UNAVAILABLE` otherwise.
+   */
+  async fetch(port: number, request: Request): Promise<Response> {
+    const validPort = validateInteger("port", port, 1, 65_535);
+    const url = new URL(request.url);
+    const body = new Uint8Array(await request.arrayBuffer());
+    const headers = [...request.headers.entries()];
+    const response = await rethrow(
+      this.#core.handleHttpRequest(
+        validPort,
+        request.method,
+        url.pathname + url.search,
+        headers,
+        body,
+      ),
+    );
+    const status = response.status;
+    const noBody = request.method === "HEAD" || status === 204 ||
+      status === 304 || (status >= 100 && status < 200);
+    return new Response(noBody ? null : Uint8Array.from(response.body), {
+      status,
+      statusText: response.statusText,
+      headers: response.headers,
+    });
+  }
+
+  /**
+   * Open a raw byte stream to a guest TCP listener (WebSockets, database
+   * protocols), without a host port.
+   *
+   * Needs browser ingress networking; fails with `CAPABILITY_UNAVAILABLE`
+   * otherwise.
+   */
+  connect(port: number): PortConnection {
+    const validPort = validateInteger("port", port, 1, 65_535);
+    const connection = rethrowSync(() => this.#core.connectTcp(validPort));
+    let closed = false;
+    const close = () => {
+      if (closed) return;
+      closed = true;
+      try {
+        connection.close();
+      } catch {
+        // Already closed by the guest.
+      }
+    };
+    const readable = new ReadableStream<Uint8Array>({
+      async pull(controller) {
+        const chunk = await rethrow(connection.read());
+        if (!chunk || chunk.length === 0) controller.close();
+        else controller.enqueue(Uint8Array.from(chunk));
+      },
+      cancel: close,
+    }, { highWaterMark: 0 });
+    const writable = new WritableStream<Uint8Array>({
+      async write(chunk) {
+        for (let offset = 0; offset < chunk.length; offset += 65_536) {
+          await rethrow(connection.write(chunk.subarray(offset, offset + 65_536)));
+        }
+      },
+      close() {
+        rethrowSync(() => connection.shutdownWrite());
+      },
+      abort: close,
+    });
+    return { readable, writable, close };
+  }
+
   /**
    * Wait until a guest TCP listener accepts connections on `port`.
    *
