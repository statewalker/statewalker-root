+import assert from "node:assert/strict";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+
+import { Wasmer } from "../dist/node.js";
+import { isHostFileSystemRequest, respondToHostFileSystem } from "../dist/host-filesystem.js";
+
+const runtimeCache =
+  process.env.WASMER_TEST_CACHE ??
+  fileURLToPath(new URL("../../.wasmer", import.meta.url));
+
+// The embedder answers every guest filesystem call under a mount, so it can
+// apply its own access policy to each operation. This one serves a read-only
+// directory with one readable file and one file it refuses to open.
+function policyEmbedder() {
+  const time = { accessed: "0", modified: "0", created: "0" };
+  const files = new Map([["public.txt", new TextEncoder().encode("hello\n")], ["secret.txt", new Uint8Array(8)]]);
+  const calls = [];
+  const open = new Map();
+  let nextId = 1;
+  const deny = (message) => Object.assign(new Error(message), { code: "EACCES" });
+  const notFound = () => Object.assign(new Error("not found"), { code: "ENOENT" });
+  const methods = {
+    stat([path]) {
+      if (path === "" || path === ".") return { kind: "directory", size: 0, ...time };
+      const file = files.get(path);
+      if (!file) throw notFound();
+      return { kind: "file", size: file.length, ...time };
+    },
+    readDir() {
+      return [...files].map(([name, file]) => ({ name, kind: "file", size: file.length, ...time }));
+    },
+    open([path, , write, create]) {
+      if (write || create) throw deny("read-only mount");
+      if (path === "secret.txt") throw deny("not for this guest");
+      if (!files.has(path)) throw notFound();
+      const id = nextId++;
+      open.set(id, files.get(path));
+      return id;
+    },
+    read([id, offset, length]) {
+      return open.get(id).subarray(offset, offset + length);
+    },
+    close([id]) {
+      open.delete(id);
+      return null;
+    },
+  };
+  const previous = globalThis.__wasmerHandleFileSystemRpc;
+  globalThis.__wasmerHandleFileSystemRpc = (message) => {
+    if (!isHostFileSystemRequest(message)) return false;
+    calls.push({ mount: message.mount, method: message.method, path: message.args[0] });
+    try {
+      const handler = methods[message.method];
+      if (!handler) throw Object.assign(new Error(message.method), { code: "ENOTSUP" });
+      respondToHostFileSystem(message, { value: handler(message.args) });
+    } catch (error) {
+      respondToHostFileSystem(message, { error: { code: error.code, message: error.message } });
+    }
+    return true;
+  };
+  return { calls, restore: () => { globalThis.__wasmerHandleFileSystemRpc = previous; } };
+}
+
+test("mounts route each guest filesystem call to the embedder, which decides it", async () => {
+  const embedder = policyEmbedder();
+  const client = new Wasmer({ cache: { directory: runtimeCache } });
+  try {
+    const sandbox = await client.sandboxes.create({
+      packages: ["python/python@=3.13.20"],
+      mounts: [{ path: "/data", mount: 7 }],
+    });
+    const script = [
+      "import os",
+      "print(sorted(os.listdir('/data')))",
+      "print(open('/data/public.txt').read(), end='')",
+      "for attempt in (lambda: open('/data/secret.txt').read(), lambda: open('/data/new.txt', 'w')):",
+      "  try:",
+      "    attempt()",
+      "  except PermissionError:",
+      "    print('denied')",
+    ].join("\n");
+    const output = await sandbox.command("python", ["-c", script]).run();
+    assert.equal(output.text(), "['public.txt', 'secret.txt']\nhello\ndenied\ndenied\n");
+    assert.ok(embedder.calls.every((call) => call.mount === 7));
+    assert.ok(embedder.calls.some((call) => call.method === "open" && call.path === "secret.txt"));
+    await sandbox.close();
+  } finally {
+    embedder.restore();
+    await client.close();
+  }
+});
+
+test("mounts and storage reject invalid arguments", async () => {
+  const client = new Wasmer({ cache: { directory: runtimeCache } });
+  try {
+    await assert.rejects(
+      client.sandboxes.create({ mounts: [{ path: "data", mount: 1 }] }),
+      { code: "INVALID_ARGUMENT" },
+    );
+    await assert.rejects(
+      client.sandboxes.create({ mounts: [{ path: "/data", mount: -1 }] }),
+      { code: "INVALID_ARGUMENT" },
+    );
+    await assert.rejects(
+      client.sandboxes.create({ storage: { mount: 1.5 } }),
+      { code: "INVALID_ARGUMENT" },
+    );
+  } finally {
+    await client.close();
+  }
+});
+
+test("ports.fetch sends one request to a guest listener without a host port", async () => {
+  const client = new Wasmer({ cache: { directory: runtimeCache } });
+  try {
+    const sandbox = await client.sandboxes.create({
+      packages: ["python/python@=3.13.20"],
+      network: { mode: "http", peers: [] },
+      files: { "index.html": "hello from the guest\n" },
+    });
+    const server = await sandbox
+      .command("python", ["-m", "http.server", "8080", "--directory", "/workspace"])
+      .spawn();
+    try {
+      await sandbox.ports.wait(8080, { timeoutMs: 30_000 });
+      const response = await sandbox.ports.fetch(8080, new Request("http://guest/index.html"));
+      assert.equal(response.status, 200);
+      assert.equal(await response.text(), "hello from the guest\n");
+      const head = await sandbox.ports.fetch(8080, new Request("http://guest/index.html", { method: "HEAD" }));
+      assert.equal(head.status, 200);
+      assert.equal(await head.text(), "");
+    } finally {
+      await server.kill();
+      await sandbox.close();
+    }
+  } finally {
+    await client.close();
+  }
+});
+
+test("ports.fetch and ports.connect need ingress networking", async () => {
+  const client = new Wasmer({ cache: { directory: runtimeCache } });
+  try {
+    const sandbox = await client.sandboxes.create({});
+    await assert.rejects(
+      sandbox.ports.fetch(8080, new Request("http://guest/")),
+      { code: "CAPABILITY_UNAVAILABLE" },
+    );
+    assert.throws(() => sandbox.ports.connect(8080), { code: "CAPABILITY_UNAVAILABLE" });
+    await sandbox.close();
+  } finally {
+    await client.close();
+  }
+});
